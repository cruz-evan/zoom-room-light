# Zoom OAuth credentials for zoom_schedule.py
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Zoom webhook Secret Token for zoom_light_webhook.py.
# This is different from your OAuth Client Secret.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Local webhook server settings
PORT=5050

# Schedule warning settings for zoom_light_webhook.py
# Use your Zoom email/user ID here if server-to-server OAuth cannot use "me".
ZOOM_SCHEDULE_USER_ID=me
SCHEDULE_LOOKAHEAD_MINUTES=15
SCHEDULE_POLL_SECONDS=60
