# Zoom OAuth credentials for zoom_schedule.py
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Zoom webhook Secret Token for zoom_light_webhook.py.
# This is different from your OAuth Client Secret.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Local webhook server settings
PORT=5050

# Schedule warning settings for zoom_light_webhook.py
# Use your Zoom email/user ID here if server-to-server OAuth cannot use "me".
ZOOM_SCHEDULE_USER_ID=me
SCHEDULE_LOOKAHEAD_MINUTES=5
ENDING_SOON_MINUTES=5
SCHEDULE_POLL_SECONDS=60
DEVICE_POLL_SECONDS=5

# Raspberry Pi Pico / RP2040 serial output for rp2-zoom-leds.
# Use "auto" on macOS, or set /dev/cu.usbmodemXXXX if multiple boards are attached.
RP2_SERIAL_ENABLED=true
RP2_SERIAL_PORT=auto
RP2_SERIAL_BAUD=115200
RP2_SERIAL_DRY_RUN=false

# Optional bearer token for Pico W polling at /device/state.
# This is a low-privilege device token, not a Zoom secret.
DEVICE_TOKEN=
